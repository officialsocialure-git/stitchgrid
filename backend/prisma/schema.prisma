generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RfqStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  AWARDED
}

enum InvitationStatus {
  INVITED
  VIEWED
  RESPONDED
  DECLINED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  REVISED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  PO_CREATED
  PENDING_ACCEPTANCE
  ACCEPTED
  SAMPLE_PENDING
  SAMPLE_APPROVED
  PRODUCTION_STARTED
  IN_PRODUCTION
  QC_PENDING
  QC
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum SampleStatus {
  REQUESTED
  IN_PROGRESS
  DISPATCHED
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model User {
  id             String   @id @default(cuid())
  fullName       String
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String
  emailVerified  Boolean  @default(false)
  phoneVerified  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    OrganizationMember[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  businessType       String?
  taxId              String?
  address            String? @db.Text
  city               String?
  country            String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  members            OrganizationMember[]
  supplierProfile    SupplierProfile?
  rfqs               Rfq[]
  quotes             Quotation[]
  buyerOrders        PurchaseOrder[] @relation("BuyerOrganization")
  supplierOrders     PurchaseOrder[] @relation("SupplierOrganization")
  @@index([verificationStatus, createdAt])
}

model OrganizationMember {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId, role])
  @@index([userId])
  @@index([organizationId])
  @@index([role, isActive])
}

model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupplierProfile {
  id                 String @id @default(cuid())
  organizationId     String @unique
  description        String? @db.Text
  yearsInBusiness    Int?
  productionCapacity Int?
  verificationStatus VerificationStatus @default(PENDING)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories         SupplierCategory[]
  catalogItems       CatalogItem[]
}

model SupplierCategory {
  id                String @id @default(cuid())
  supplierProfileId String
  category          String
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  @@unique([supplierProfileId, category])
}

enum CatalogModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CatalogItem {
  id                String @id @default(cuid())
  supplierProfileId String
  name              String
  description       String? @db.Text
  itemType          String
  moq               Int?
  unitPrice         Decimal? @db.Decimal(12, 2)
  currency          String @default("INR")
  moderationStatus  CatalogModerationStatus @default(PENDING)
  moderationNote    String? @db.Text
  createdAt         DateTime @default(now())
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
}

model Rfq {
  id             String @id @default(cuid())
  buyerOrgId     String
  title          String
  description    String? @db.Text
  garmentType    String?
  fabricSpec     String? @db.Text
  targetPrice    Decimal? @db.Decimal(12, 2)
  targetQuantity Int
  targetDate     DateTime?
  status         RfqStatus @default(OPEN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  buyer          Organization @relation(fields: [buyerOrgId], references: [id])
  items          RfqItem[]
  invitations    RfqInvitation[]
  quotations     Quotation[]
  @@index([buyerOrgId, status])
}

model RfqItem {
  id          String @id @default(cuid())
  rfqId       String
  name        String
  description String? @db.Text
  quantity    Int
  unit        String @default("pieces")
  rfq         Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model RfqInvitation {
  id             String @id @default(cuid())
  rfqId          String
  supplierOrgId  String
  status         InvitationStatus @default(INVITED)
  invitedAt      DateTime @default(now())
  rfq            Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  @@unique([rfqId, supplierOrgId])
  @@index([supplierOrgId, status])
}

model Quotation {
  id             String @id @default(cuid())
  rfqId          String
  supplierOrgId  String
  buyerOrgId     String
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String @default("INR")
  leadTimeDays   Int
  sampleCost     Decimal? @db.Decimal(12, 2)
  sampleLeadDays Int?
  moq            Int?
  validityUntil  DateTime?
  terms          String? @db.Text
  status         QuoteStatus @default(SUBMITTED)
  revision       Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rfq            Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier       Organization @relation(fields: [supplierOrgId], references: [id])
  items          QuotationItem[]
  @@index([rfqId, supplierOrgId])
  @@index([buyerOrgId, status])
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  rfqItemId   String?
  description String @db.Text
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id             String @id @default(cuid())
  poNumber       String @unique
  buyerOrgId     String
  supplierOrgId  String
  quotationId    String @unique
  status         OrderStatus @default(PENDING_ACCEPTANCE)
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String @default("INR")
  expectedDate   DateTime?
  dispatchDate   DateTime?
  trackingNumber String?
  deliveryDate   DateTime?
  qcNotes        String? @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  buyer          Organization @relation("BuyerOrganization", fields: [buyerOrgId], references: [id])
  supplier       Organization @relation("SupplierOrganization", fields: [supplierOrgId], references: [id])
  items          PurchaseOrderItem[]
  milestones     OrderMilestone[]
  samples        Sample[]
  events         OrderEvent[]
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  purchaseOrderId String
  name        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model OrderMilestone {
  id              String @id @default(cuid())
  purchaseOrderId String
  title           String
  status          MilestoneStatus @default(PENDING)
  dueDate         DateTime?
  completedAt     DateTime?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model OrderEvent {
  id              String @id @default(cuid())
  purchaseOrderId String
  eventType       String
  note            String? @db.Text
  actorUserId     String
  createdAt       DateTime @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Sample {
  id              String @id @default(cuid())
  purchaseOrderId String
  status          SampleStatus @default(REQUESTED)
  notes           String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  title     String
  body      String @db.Text
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}

model Conversation {
  id             String @id @default(cuid())
  buyerOrgId     String
  supplierOrgId  String
  createdAt      DateTime @default(now())
  messages       Message[]
  @@unique([buyerOrgId, supplierOrgId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String @db.Text
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id             String @id @default(cuid())
  purchaseOrderId String
  provider       String
  providerRef    String? @unique
  amount         Decimal @db.Decimal(12, 2)
  currency       String @default("INR")
  status         String @default("PENDING")
  createdAt      DateTime @default(now())
}

model Dispute {
  id              String @id @default(cuid())
  purchaseOrderId String
  raisedByUserId  String
  reason          String @db.Text
  status          String @default("OPEN")
  resolution      String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id              String @id @default(cuid())
  purchaseOrderId String @unique
  reviewerOrgId   String
  reviewedOrgId   String
  rating          Int
  comment         String? @db.Text
  createdAt       DateTime @default(now())
}

model AuditLog {
  id             String @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())
  user           User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}
