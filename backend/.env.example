NODE_ENV=development
PORT=5000

# Local MySQL development database
DATABASE_URL="mysql://root:password@localhost:3306/stitchgrid_db"

# TiDB Cloud Starter (use this URL format for cloud testing/deployment).
# URL-encode any special characters in the password.
# DATABASE_URL="mysql://<TIDB_USERNAME>:<URL_ENCODED_PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/stitchgrid_db?sslaccept=strict"

JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
CLIENT_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Email OTP transport (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STITCHGRID <no-reply@example.com>

# SMS provider integration is intentionally adapter-based; configure provider credentials before enabling SMS OTP.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
