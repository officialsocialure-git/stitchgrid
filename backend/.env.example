NODE_ENV=development
PORT=5000

# Local MySQL development database
DATABASE_URL="mysql://root:password@localhost:3306/stitchgrid_db"

# TiDB Cloud Starter (use this URL format for cloud testing/deployment).
# URL-encode any special characters in the password.
# DATABASE_URL="mysql://<TIDB_USERNAME>:<URL_ENCODED_PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/stitchgrid_db?sslaccept=strict"

JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=7d
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
CLIENT_ORIGIN=https://stitchgrid-three.vercel.app,http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay Payments (keep secrets only in backend/Render environment; never expose the secret to the browser)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
# Enable only after Razorpay approves Route/marketplace settlements for STITCHGRID
RAZORPAY_ROUTE_ENABLED=false
# Redis Key Value (Render Free Plan Internal Redis URL or local)
# Render Internal format: redis://red-xxxxxxxxxxxx:6379
REDIS_URL=redis://localhost:6379

# Resend Email API over HTTPS (Port 443 - Works reliably on Render Free Plan)
# 1. Sign up free at https://resend.com (100 emails/day, 3,000/month free)
# 2. Create an API Key (starts with re_...)
RESEND_API_KEY=re_your_api_key_here
# In production with verified domain: STITCHGRID <auth@yourdomain.com>
# In testing without custom domain: STITCHGRID <onboarding@resend.dev>
RESEND_FROM=STITCHGRID <onboarding@resend.dev>
# Set ALLOW_DEV_OTP=true on Render during testing if you do not have a custom domain yet.
# When true, if Resend restricts sending to non-owner test emails, OTP is returned in the API response.
ALLOW_DEV_OTP=true

# Legacy SMTP transport (optional fallback, note: ports 25/465/587 blocked on Render free tier)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STITCHGRID <no-reply@example.com>

# MSG91 Flow SMS OTP (approved template; OTP variable should be VAR1)
SMS_PROVIDER=MSG91
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
