NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/stitchgrid?schema=public
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
# Email OTP transport (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STITCHGRID <no-reply@example.com>
# SMS provider integration is intentionally adapter-based; configure provider credentials before enabling SMS OTP.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
