.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Code Coverage
coverage/
.nyc_output/

# Cloud Hosting & Deployment Previews
.vercel/
.netlify/

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Configuration
.idea/
.vscode/
*.sublime-project
