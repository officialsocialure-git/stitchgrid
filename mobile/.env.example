# ==============================================================================
# STITCHGUARD Mobile Environment Configuration
# ==============================================================================
# In Expo SDK 50+, all variables prefixed with EXPO_PUBLIC_ are inlined at build time.
#
# 1. LOCAL DEVELOPMENT (when testing against your local Node.js/Express backend):
#    Replace with your computer's LAN IP (do NOT use localhost on real physical phones)
#    EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
#    EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:5000
#    EXPO_PUBLIC_APP_ENV=development
#
# 2. PREVIEW & PRODUCTION (live cloud backend):
#    Default live backend endpoints for EAS Preview (.apk/.ipa) and OTA updates:
EXPO_PUBLIC_API_URL=https://stitchgrid-backend.onrender.com/api
EXPO_PUBLIC_SOCKET_URL=https://stitchgrid-backend.onrender.com
EXPO_PUBLIC_APP_ENV=production

# Google OAuth Web Client ID for mobile Google Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID=80140512080-4pt12rrtpbt75ensbhup0td4uq9lis.apps.googleusercontent.com
