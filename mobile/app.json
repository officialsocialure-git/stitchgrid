{
  "expo": {
    "name": "STITCHGUARD",
    "slug": "stitchguard-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stitchguard",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stitchguard.app",
      "infoPlist": {
        "NSCameraUsageDescription": "STITCHGUARD needs camera access to capture apparel and sample inspection photos.",
        "NSPhotoLibraryUsageDescription": "STITCHGUARD needs photo library access to upload garment specification and QC photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.stitchguard.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "STITCHGUARD - Garment Manufacturing Network",
      "shortName": "STITCHGUARD",
      "themeColor": "#5B13EC",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
